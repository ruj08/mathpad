{
  "name": "mathpad",
  "productName": "Mathpad",
  "version": "1.1.0",
  "description": "Math notes in plain text: type x^2/3 or int_0^1 x^2 dx and see real notation.",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "test": "node test/parser.test.js"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "mathjax": "^3.2.2"
  },
  "build": {
    "appId": "app.mathpad.notes",
    "productName": "Mathpad",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "publish": null,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mathpad",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Mathpad",
      "artifactName": "Mathpad-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
